# ---- Required in production ----
APP_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 32`. Changing it makes stored answers unreadable.
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Supabase (leave empty for demo mode: file-backed store in .data/)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email via Resend (leave empty to write emails to .data/outbox)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="ReadyPlan <plans@yourdomain.com>"
# CAN-SPAM: your physical mailing address, shown in every email footer
MAILING_ADDRESS="ReadyPlan · 123 Main St · Anytown, ST 00000"

# LLM wording layer (optional; without it the deterministic template wording is used)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Bot protection (Cloudflare Turnstile; leave empty to disable in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Comma-separated emails allowed into /admin
ADMIN_EMAILS=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=
